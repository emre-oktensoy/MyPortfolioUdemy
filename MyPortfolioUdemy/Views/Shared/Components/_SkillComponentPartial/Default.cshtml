@model List<MyPortfolioUdemy.DAL.Entities.Skill>

<div class="col-six tab-full right">
    <h3>Programlama Dilleri/Projeler</h3>

    <ul class="skill-bars">

        @foreach (var item in Model)
        {
            <li>
                <div class="progress percent@item.Value"><span>@item.Value%</span></div>
                <strong>@item.Value</strong>

            </li>
        }
        
    </ul>
</div>